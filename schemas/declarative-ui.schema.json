{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://buildplay.fun/games/declarative/schema",
  "title": "BuildPlay Declarative UI v1",
  "description": "Portable JSON scene contract. The reducer is pure ES2020 JavaScript defining gameUI.reduce(message, localState). No game HTML or browser APIs are required. Geometry uses viewport logical units; positions are relative to a board. Grid cell IDs are row-major decimal strings. Hex, graph and track boards provide explicit cells. Reference and size checks also apply at submission/runtime.",
  "type": "object",
  "properties": {
    "format": {
      "const": "buildplay-ui"
    },
    "version": {
      "const": 1
    },
    "viewport": {
      "type": "object",
      "properties": {
        "width": {
          "type": "number",
          "exclusiveMinimum": 0,
          "maximum": 100000
        },
        "height": {
          "type": "number",
          "exclusiveMinimum": 0,
          "maximum": 100000
        }
      },
      "required": [
        "width",
        "height"
      ],
      "additionalProperties": false
    },
    "assets": {
      "type": "object",
      "maxProperties": 128,
      "propertyNames": {
        "type": "string",
        "minLength": 1,
        "maxLength": 80,
        "pattern": "^[A-Za-z0-9_.:-]+$"
      },
      "additionalProperties": {
        "$ref": "#/$defs/asset"
      }
    },
    "boards": {
      "type": "array",
      "items": {
        "$ref": "#/$defs/board"
      },
      "maxItems": 32,
      "minItems": 1
    },
    "piece_types": {
      "type": "object",
      "minProperties": 1,
      "maxProperties": 128,
      "propertyNames": {
        "type": "string",
        "minLength": 1,
        "maxLength": 80,
        "pattern": "^[A-Za-z0-9_.:-]+$"
      },
      "additionalProperties": {
        "$ref": "#/$defs/piece_type"
      }
    },
    "strings": {
      "type": "object",
      "maxProperties": 400,
      "propertyNames": {
        "type": "string",
        "pattern": "^[A-Za-z0-9_.-]{1,64}$"
      },
      "additionalProperties": {
        "type": "string",
        "maxLength": 1000
      }
    },
    "ui_code": {
      "type": "string",
      "minLength": 1,
      "maxLength": 200000
    }
  },
  "required": [
    "format",
    "version",
    "viewport",
    "boards",
    "piece_types",
    "ui_code"
  ],
  "additionalProperties": false,
  "$defs": {
    "asset": {
      "type": "object",
      "properties": {
        "uri": {
          "type": "string",
          "maxLength": 240000,
          "pattern": "^(data:image/(png|jpeg|svg\\+xml);base64,[A-Za-z0-9+/=]+|https://[^\\s]+)$"
        },
        "media_type": {
          "enum": [
            "image/png",
            "image/jpeg",
            "image/svg+xml"
          ]
        },
        "width": {
          "type": "number",
          "exclusiveMinimum": 0,
          "maximum": 100000
        },
        "height": {
          "type": "number",
          "exclusiveMinimum": 0,
          "maximum": 100000
        },
        "alt": {
          "type": "string",
          "maxLength": 4000
        }
      },
      "required": [
        "uri",
        "media_type"
      ],
      "additionalProperties": false
    },
    "point": {
      "type": "object",
      "properties": {
        "x": {
          "type": "number",
          "minimum": -100000,
          "maximum": 100000
        },
        "y": {
          "type": "number",
          "minimum": -100000,
          "maximum": 100000
        }
      },
      "required": [
        "x",
        "y"
      ],
      "additionalProperties": false
    },
    "position": {
      "type": "object",
      "properties": {
        "cell": {
          "type": "string",
          "minLength": 1,
          "maxLength": 80,
          "pattern": "^[A-Za-z0-9_.:-]+$"
        },
        "x": {
          "type": "number",
          "minimum": -100000,
          "maximum": 100000
        },
        "y": {
          "type": "number",
          "minimum": -100000,
          "maximum": 100000
        }
      },
      "required": [],
      "additionalProperties": false,
      "oneOf": [
        {
          "required": [
            "cell"
          ],
          "not": {
            "anyOf": [
              {
                "required": [
                  "x"
                ]
              },
              {
                "required": [
                  "y"
                ]
              }
            ]
          }
        },
        {
          "required": [
            "x",
            "y"
          ],
          "not": {
            "required": [
              "cell"
            ]
          }
        }
      ]
    },
    "cell": {
      "type": "object",
      "properties": {
        "id": {
          "type": "string",
          "minLength": 1,
          "maxLength": 80,
          "pattern": "^[A-Za-z0-9_.:-]+$"
        },
        "x": {
          "type": "number",
          "minimum": -100000,
          "maximum": 100000
        },
        "y": {
          "type": "number",
          "minimum": -100000,
          "maximum": 100000
        },
        "label": {
          "type": "string",
          "maxLength": 4000
        },
        "color": {
          "type": "string",
          "pattern": "^#[0-9A-Fa-f]{6}([0-9A-Fa-f]{2})?$"
        }
      },
      "required": [
        "id",
        "x",
        "y"
      ],
      "additionalProperties": false
    },
    "board": {
      "type": "object",
      "properties": {
        "id": {
          "type": "string",
          "minLength": 1,
          "maxLength": 80,
          "pattern": "^[A-Za-z0-9_.:-]+$"
        },
        "kind": {
          "enum": [
            "grid",
            "hex",
            "graph",
            "track",
            "free",
            "zone"
          ]
        },
        "x": {
          "type": "number",
          "minimum": -100000,
          "maximum": 100000
        },
        "y": {
          "type": "number",
          "minimum": -100000,
          "maximum": 100000
        },
        "width": {
          "type": "number",
          "exclusiveMinimum": 0,
          "maximum": 100000
        },
        "height": {
          "type": "number",
          "exclusiveMinimum": 0,
          "maximum": 100000
        },
        "rows": {
          "type": "integer",
          "minimum": 1,
          "maximum": 100
        },
        "columns": {
          "type": "integer",
          "minimum": 1,
          "maximum": 100
        },
        "color": {
          "type": "string",
          "pattern": "^#[0-9A-Fa-f]{6}([0-9A-Fa-f]{2})?$"
        },
        "alternate_color": {
          "type": "string",
          "pattern": "^#[0-9A-Fa-f]{6}([0-9A-Fa-f]{2})?$"
        },
        "line_color": {
          "type": "string",
          "pattern": "^#[0-9A-Fa-f]{6}([0-9A-Fa-f]{2})?$"
        },
        "background_asset": {
          "type": "string",
          "minLength": 1,
          "maxLength": 80,
          "pattern": "^[A-Za-z0-9_.:-]+$"
        },
        "cells": {
          "type": "array",
          "items": {
            "$ref": "#/$defs/cell"
          },
          "maxItems": 2048
        },
        "links": {
          "type": "array",
          "items": {
            "type": "object",
            "properties": {
              "from": {
                "type": "string",
                "minLength": 1,
                "maxLength": 80,
                "pattern": "^[A-Za-z0-9_.:-]+$"
              },
              "to": {
                "type": "string",
                "minLength": 1,
                "maxLength": 80,
                "pattern": "^[A-Za-z0-9_.:-]+$"
              }
            },
            "required": [
              "from",
              "to"
            ],
            "additionalProperties": false
          },
          "maxItems": 4096
        }
      },
      "required": [
        "id",
        "kind",
        "x",
        "y",
        "width",
        "height"
      ],
      "additionalProperties": false,
      "allOf": [
        {
          "if": {
            "properties": {
              "kind": {
                "const": "grid"
              }
            }
          },
          "then": {
            "required": [
              "rows",
              "columns"
            ]
          }
        },
        {
          "if": {
            "properties": {
              "kind": {
                "enum": [
                  "hex",
                  "graph",
                  "track"
                ]
              }
            }
          },
          "then": {
            "required": [
              "cells"
            ]
          }
        }
      ]
    },
    "piece_type": {
      "type": "object",
      "properties": {
        "shape": {
          "enum": [
            "circle",
            "rect",
            "card",
            "dice",
            "image",
            "text"
          ]
        },
        "width": {
          "type": "number",
          "exclusiveMinimum": 0,
          "maximum": 100000
        },
        "height": {
          "type": "number",
          "exclusiveMinimum": 0,
          "maximum": 100000
        },
        "color": {
          "type": "string",
          "pattern": "^#[0-9A-Fa-f]{6}([0-9A-Fa-f]{2})?$"
        },
        "text_color": {
          "type": "string",
          "pattern": "^#[0-9A-Fa-f]{6}([0-9A-Fa-f]{2})?$"
        },
        "border_color": {
          "type": "string",
          "pattern": "^#[0-9A-Fa-f]{6}([0-9A-Fa-f]{2})?$"
        },
        "asset": {
          "type": "string",
          "minLength": 1,
          "maxLength": 80,
          "pattern": "^[A-Za-z0-9_.:-]+$"
        },
        "back_asset": {
          "type": "string",
          "minLength": 1,
          "maxLength": 80,
          "pattern": "^[A-Za-z0-9_.:-]+$",
          "description": "Artwork for face=back. Front artwork and text must remain hidden when the piece is face down."
        }
      },
      "required": [
        "shape"
      ],
      "additionalProperties": false
    },
    "piece": {
      "type": "object",
      "properties": {
        "id": {
          "type": "string",
          "minLength": 1,
          "maxLength": 80,
          "pattern": "^[A-Za-z0-9_.:-]+$"
        },
        "type": {
          "type": "string",
          "minLength": 1,
          "maxLength": 80,
          "pattern": "^[A-Za-z0-9_.:-]+$"
        },
        "board": {
          "type": "string",
          "minLength": 1,
          "maxLength": 80,
          "pattern": "^[A-Za-z0-9_.:-]+$"
        },
        "position": {
          "$ref": "#/$defs/position"
        },
        "text": {
          "type": "string",
          "maxLength": 4000
        },
        "asset": {
          "type": "string",
          "minLength": 1,
          "maxLength": 80,
          "pattern": "^[A-Za-z0-9_.:-]+$"
        },
        "rotation": {
          "type": "number",
          "minimum": -100000,
          "maximum": 100000
        },
        "scale": {
          "type": "number",
          "exclusiveMinimum": 0,
          "maximum": 100
        },
        "opacity": {
          "type": "number",
          "minimum": 0,
          "maximum": 1
        },
        "z": {
          "type": "number",
          "minimum": -100000,
          "maximum": 100000
        },
        "face": {
          "enum": [
            "front",
            "back"
          ]
        },
        "move_targets": {
          "type": "array",
          "items": {
            "type": "string",
            "minLength": 1,
            "maxLength": 80,
            "pattern": "^[A-Za-z0-9_.:-]+$"
          },
          "maxItems": 2048,
          "uniqueItems": true
        },
        "actions": {
          "type": "array",
          "description": "Available piece operations, used by hosts to show persistent action hints. Nonempty move_targets always implies move. Omit for legacy tap behavior; use [] and no move_targets for a passive piece. Rotation/scale presentation values alone do not grant actions.",
          "items": {
            "enum": [
              "tap",
              "move",
              "rotate",
              "scale"
            ]
          },
          "maxItems": 4,
          "uniqueItems": true
        },
        "selected": {
          "type": "boolean"
        },
        "hidden": {
          "type": "boolean"
        },
        "draggable": {
          "type": "boolean"
        }
      },
      "required": [
        "id",
        "type",
        "board",
        "position"
      ],
      "additionalProperties": false,
      "allOf": [
        {
          "if": {
            "required": ["actions"],
            "properties": {
              "actions": {"contains": {"const": "move"}}
            }
          },
          "then": {
            "required": ["move_targets"],
            "properties": {
              "move_targets": {"minItems": 1}
            }
          }
        }
      ]
    },
    "target": {
      "type": "object",
      "properties": {
        "id": {
          "type": "string",
          "minLength": 1,
          "maxLength": 80,
          "pattern": "^[A-Za-z0-9_.:-]+$"
        },
        "board": {
          "type": "string",
          "minLength": 1,
          "maxLength": 80,
          "pattern": "^[A-Za-z0-9_.:-]+$"
        },
        "position": {
          "$ref": "#/$defs/position"
        },
        "label": {
          "type": "string",
          "maxLength": 4000
        },
        "color": {
          "type": "string",
          "pattern": "^#[0-9A-Fa-f]{6}([0-9A-Fa-f]{2})?$"
        }
      },
      "required": [
        "id",
        "board",
        "position"
      ],
      "additionalProperties": false
    },
    "control": {
      "type": "object",
      "properties": {
        "id": {
          "type": "string",
          "minLength": 1,
          "maxLength": 80,
          "pattern": "^[A-Za-z0-9_.:-]+$"
        },
        "label": {
          "type": "string",
          "maxLength": 4000
        },
        "kind": {
          "enum": [
            "button",
            "number",
            "choice",
            "text"
          ]
        },
        "value": {
          "type": [
            "string",
            "number",
            "boolean",
            "null"
          ]
        },
        "min": {
          "type": "number",
          "minimum": -100000,
          "maximum": 100000
        },
        "max": {
          "type": "number",
          "minimum": -100000,
          "maximum": 100000
        },
        "step": {
          "type": "number",
          "exclusiveMinimum": 0,
          "maximum": 100000
        },
        "options": {
          "type": "array",
          "items": {
            "type": "object",
            "properties": {
              "value": {
                "type": [
                  "string",
                  "number",
                  "boolean"
                ]
              },
              "label": {
                "type": "string",
                "maxLength": 4000
              }
            },
            "required": [
              "value",
              "label"
            ],
            "additionalProperties": false
          },
          "maxItems": 100
        },
        "disabled": {
          "type": "boolean"
        }
      },
      "required": [
        "id",
        "label",
        "kind"
      ],
      "additionalProperties": false
    },
    "label": {
      "type": "object",
      "properties": {
        "id": {
          "type": "string",
          "minLength": 1,
          "maxLength": 80,
          "pattern": "^[A-Za-z0-9_.:-]+$"
        },
        "text": {
          "type": "string",
          "maxLength": 4000
        },
        "x": {
          "type": "number",
          "minimum": -100000,
          "maximum": 100000
        },
        "y": {
          "type": "number",
          "minimum": -100000,
          "maximum": 100000
        },
        "color": {
          "type": "string",
          "pattern": "^#[0-9A-Fa-f]{6}([0-9A-Fa-f]{2})?$"
        },
        "font_size": {
          "type": "number",
          "exclusiveMinimum": 0,
          "maximum": 100000
        }
      },
      "required": [
        "id",
        "text",
        "x",
        "y"
      ],
      "additionalProperties": false
    },
    "path": {
      "type": "object",
      "properties": {
        "id": {
          "type": "string",
          "minLength": 1,
          "maxLength": 80,
          "pattern": "^[A-Za-z0-9_.:-]+$"
        },
        "points": {
          "type": "array",
          "items": {
            "$ref": "#/$defs/point"
          },
          "maxItems": 4096,
          "minItems": 2
        },
        "color": {
          "type": "string",
          "pattern": "^#[0-9A-Fa-f]{6}([0-9A-Fa-f]{2})?$"
        },
        "width": {
          "type": "number",
          "exclusiveMinimum": 0,
          "maximum": 100000
        }
      },
      "required": [
        "id",
        "points"
      ],
      "additionalProperties": false
    },
    "scene": {
      "type": "object",
      "properties": {
        "pieces": {
          "type": "array",
          "items": {
            "$ref": "#/$defs/piece"
          },
          "maxItems": 2048
        },
        "targets": {
          "type": "array",
          "items": {
            "$ref": "#/$defs/target"
          },
          "maxItems": 2048
        },
        "labels": {
          "type": "array",
          "items": {
            "$ref": "#/$defs/label"
          },
          "maxItems": 128
        },
        "controls": {
          "type": "array",
          "items": {
            "$ref": "#/$defs/control"
          },
          "maxItems": 128
        },
        "paths": {
          "type": "array",
          "items": {
            "$ref": "#/$defs/path"
          },
          "maxItems": 128
        }
      },
      "required": [],
      "additionalProperties": false
    },
    "response": {
      "type": "object",
      "properties": {
        "scene": {
          "$ref": "#/$defs/scene"
        },
        "local_state": {},
        "make_move": {}
      },
      "required": [
        "scene"
      ],
      "additionalProperties": false
    },
    "event": {
      "type": "object",
      "properties": {
        "type": {
          "enum": [
            "tap",
            "drop",
            "change",
            "rotate",
            "scale"
          ]
        },
        "id": {
          "type": "string",
          "minLength": 1,
          "maxLength": 80,
          "pattern": "^[A-Za-z0-9_.:-]+$"
        },
        "piece_id": {
          "type": "string",
          "minLength": 1,
          "maxLength": 80,
          "pattern": "^[A-Za-z0-9_.:-]+$"
        },
        "target_id": {
          "type": "string",
          "minLength": 1,
          "maxLength": 80,
          "pattern": "^[A-Za-z0-9_.:-]+$"
        },
        "value": {
          "type": [
            "string",
            "number",
            "boolean",
            "null"
          ],
          "maxLength": 4000
        },
        "delta": {
          "type": "number",
          "description": "Requested relative clockwise rotation in degrees. The reducer applies or rejects it; the host never changes authoritative state.",
          "minimum": -360,
          "maximum": 360,
          "not": {"const": 0}
        },
        "factor": {
          "type": "number",
          "description": "Requested positive relative scale multiplier. The reducer owns the resulting scene or move.",
          "exclusiveMinimum": 0,
          "maximum": 100
        }
      },
      "required": [
        "type",
        "id"
      ],
      "additionalProperties": false,
      "allOf": [
        {
          "if": {
            "properties": {
              "type": {
                "const": "drop"
              }
            }
          },
          "then": {
            "required": [
              "piece_id",
              "target_id"
            ]
          }
        },
        {
          "if": {"properties": {"type": {"const": "rotate"}}},
          "then": {"required": ["delta"]},
          "else": {"not": {"required": ["delta"]}}
        },
        {
          "if": {"properties": {"type": {"const": "scale"}}},
          "then": {"required": ["factor"]},
          "else": {"not": {"required": ["factor"]}}
        }
      ]
    },
    "state_changed": {
      "type": "object",
      "description": "The existing platform Game API viewer message. Only the viewer-filtered state/view belongs here; never send authoritative hidden state. Additional platform metadata is permitted for forwards compatibility.",
      "properties": {
        "type": {
          "const": "state_changed"
        },
        "state": {},
        "view": {},
        "status": {
          "enum": [
            "ongoing",
            "over"
          ]
        },
        "my_player_index": {
          "type": [
            "integer",
            "null"
          ],
          "minimum": 0,
          "maximum": 9
        },
        "acting_for_player_index": {
          "type": [
            "integer",
            "null"
          ],
          "minimum": 0,
          "maximum": 9
        },
        "move_count": {
          "type": "integer",
          "minimum": 0
        },
        "players": {
          "type": "array",
          "maxItems": 10,
          "items": {
            "type": "object"
          }
        },
        "turn_of_player_indices": {
          "type": [
            "array",
            "null"
          ],
          "items": {
            "type": "integer",
            "minimum": 0,
            "maximum": 9
          },
          "maxItems": 10,
          "uniqueItems": true
        },
        "strings": {
          "type": "object",
          "additionalProperties": {
            "type": "string",
            "maxLength": 4000
          },
          "maxProperties": 400
        },
        "locale": {
          "type": "string",
          "maxLength": 16
        },
        "direction": {
          "enum": [
            "ltr",
            "rtl"
          ]
        }
      },
      "required": [
        "type",
        "view",
        "status",
        "acting_for_player_index"
      ],
      "additionalProperties": true
    },
    "ui_event": {
      "type": "object",
      "properties": {
        "type": {
          "const": "ui_event"
        },
        "event": {
          "$ref": "#/$defs/event"
        },
        "state_changed": {
          "$ref": "#/$defs/state_changed"
        }
      },
      "required": [
        "type",
        "event",
        "state_changed"
      ],
      "additionalProperties": false
    },
    "message": {
      "oneOf": [
        {
          "$ref": "#/$defs/state_changed"
        },
        {
          "$ref": "#/$defs/ui_event"
        }
      ]
    }
  }
}
