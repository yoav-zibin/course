+function playPawn(st, ctx, playerId, move){
+  var playedRoll = st.roll, h = st.pieces[playerId][move.piece];
+  if(move.back){
+    st.pieces[playerId][move.piece] = h - playedRoll;
+  } else {
+    var r = resolveDest(st, ctx, playerId, move.piece);
+    var dest = r.to;
+    if(dest === 0){
+      st.pieces[playerId][move.piece] = 0;
+    } else {
+      var o = occ(st, ctx, dest);
+      var victim = (o && o.pid !== playerId && !defended(st, ctx, playerId, dest)) ? o : null;
+      st.pieces[playerId][move.piece] = dest;
+      if(victim){
+        // Capture: the beaten pawn goes to the first empty house
+        // below the house where it was hit.
+        var vp = firstEmptyBelow(st, ctx, dest - 1);
+        st.pieces[victim.pid][victim.idx] = vp;
+        st.visited[victim.pid][victim.idx] = vp >= 26;
+      }
+      if(dest === 27){
+        // The House of Water sends the pawn back to house 15, or the
+        // first empty house below it.
+        var back = occ(st, ctx, 15) ? firstEmptyBelow(st, ctx, 14) : 15;
+        st.pieces[playerId][move.piece] = back;
+        st.visited[playerId][move.piece] = false;
+      } else if(dest === 26){
+        st.visited[playerId][move.piece] = true;
+      }
+    }
+  }
+}
