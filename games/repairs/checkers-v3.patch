--- a/ui.js
+++ b/ui.js
@@ -298,0 +299,30 @@
+
+(function installCheckersDrag() {
+  const reduce = gameUI.reduce;
+  const cell = at => String(at.r * 8 + at.c);
+  const targetId = move => 'checkers-drop-' + cell(move.to);
+  gameUI.reduce = function (message, localState) {
+    const state = message.type === 'ui_event' ? message.state_changed : message;
+    const active = state.status === 'ongoing' && !state.replay && state.acting_for_player_index != null;
+    const moves = active ? (state.view || state.state)?.moves || [] : [];
+    const frame = reduce(message, localState);
+    const targets = new Map();
+    frame.scene.labels = [];
+    const event = message.type === 'ui_event' ? message.event : null;
+    delete frame.make_move;
+    for (const piece of frame.scene.pieces) {
+      const options = moves.filter(move => cell(move.from) === piece.position.cell);
+      if (!options.length) continue;
+      piece.actions = ['move'];
+      piece.move_targets = options.map(targetId);
+      for (const move of options) {
+        targets.set(targetId(move), {id:targetId(move),board:'main',position:{cell:cell(move.to)},label:move.cap?'×':'•'});
+        if (event?.type === 'drop' && event.piece_id === piece.id && event.target_id === targetId(move)) {
+          frame.make_move = {from:move.from,to:move.to};
+        }
+      }
+    }
+    frame.scene.targets = Array.from(targets.values());
+    return frame;
+  };
+})();
