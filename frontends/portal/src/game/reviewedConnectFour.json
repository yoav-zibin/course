  "ui_code": "// Original native presentation inspired by the reference's physical rack and column interaction.\nconst SOURCE_STRINGS={\"server_invalid\":\"Illegal move\",\"title\":\"Connect Four\",\"turn\":\"Turn: {n}\",\"waiting\":\"Waiting: {n}\",\"wins\":\"Player {n} wins\",\"draw\":\"Draw: no four in a row\",\"early\":\"Match ended early\",\"history\":\"History: read only\",\"goal\":\"Connect four in a row. Drag the disc to a column, or tap a column.\",\"reserve\":\"Player {n} reserve disc\",\"disc_at\":\"Player {n} disc, row {r}, column {c}\",\"drop_column\":\"Drop player {n} disc in column {c}\"};\nconst gameUI={reduce(message,localState){\n const m=message.type==='ui_event'?message.state_changed:message,s=m.view||m.state;\n const dict=Object.assign({},SOURCE_STRINGS,m.strings||{}),t=(k,a={})=>dict[k].replace(/\\{(\\w+)\\}/g,(_,x)=>String(a[x]??''));\n const active=m.status==='ongoing'&&!s.over&&!m.replay&&Number.isInteger(m.my_player_index)&&m.my_player_index===m.acting_for_player_index&&(m.turn_of_player_indices||[]).includes(m.my_player_index);\n const legal=active?(s.legal||[]):[],pieces=[],targets=[],labels=[],paths=[],labelX=m.direction==='rtl'?370:88;\n let status=m.status==='over'&&!s.over?t('early'):s.over?s.winner===-1?t('draw'):t('wins',{n:s.winner+1}):m.replay?t('history'):t(active?'turn':'waiting',{n:s.turn+1});\n // Keep source identity and instructional content available without shortening player names.\n labels.push({id:'title',text:t('title'),x:labelX,y:20,font_size:20,color:'#ffffff'});\n // Status wraps across two lines in all source dictionaries; independent aria names carry full descriptions.\n const clusters=text=>{const a=[];for(const ch of Array.from(text)){const prior=a[a.length-1]||'';if(a.length&&(/\\p{Mark}/u.test(ch)||ch==='\\u200d'||prior.endsWith('\\u200d')||prior.endsWith('\\u094d')))a[a.length-1]+=ch;else a.push(ch);}return a;};\n let chars=clusters(status),line=0;while(chars.length){labels.push({id:'status_'+line,text:chars.splice(0,22).join(''),x:labelX,y:45+line*20,font_size:16,color:'#ffffff'});line++;}\n labels.push({id:'goal',text:t('goal'),x:12,y:425,font_size:18,color:'#ffffff'});\n s.board.forEach((seat,cell)=>{if(seat!==-1)pieces.push({id:'disc_'+s.disc_ids[cell],type:'p'+seat,board:'main',position:{x:25+50*(cell%7),y:34+50*Math.floor(cell/7)},text:String(seat+1),aria_label:t('disc_at',{n:seat+1,r:Math.floor(cell/7)+1,c:cell%7+1}),actions:[]});});\n if(!s.over&&m.status==='ongoing')pieces.push({id:'disc_'+s.turns,type:'p'+s.turn,board:'reserve',position:{x:37,y:38},text:String(s.turn+1),aria_label:t('reserve',{n:s.turn+1}),actions:legal.length?['move']:[],...(legal.length?{move_targets:legal.map(x=>'column_'+x.column)}:{})});\n for(const option of legal){const aria=t('drop_column',{n:s.turn+1,c:option.column+1});targets.push({id:'column_'+option.column,board:'main',position:{x:25+50*option.column,y:144},color:s.turn===0?'#ffdc4508':'#f0485b08',aria_label:aria,hit_area:{x:-25,y:-164,width:50,height:328}});pieces.push({id:'hint_'+option.column,type:'arrow'+s.turn,board:'main',position:{x:25+50*option.column,y:6},aria_label:aria,actions:[]});}\n // Highlight every winning disc; lines are derived only from the public terminal board.\n if(s.over&&s.winner>=0)for(let cell=0;cell<42;cell++)for(const[dr,dc]of[[0,1],[1,0],[1,1],[1,-1]]){const r=Math.floor(cell/7),c=cell%7,rr=r+3*dr,cc=c+3*dc;if(rr<6&&cc>=0&&cc<7&&[0,1,2,3].every(i=>s.board[(r+i*dr)*7+c+i*dc]===s.winner))paths.push({id:'win_'+cell+'_'+dr+'_'+(dc+1),points:[{x:12+37+50*c,y:90+34+50*r},{x:12+37+50*cc,y:90+34+50*rr}],width:5,color:'#ffffff'});}\n const out={scene:{pieces,targets,labels,paths,controls:[]},local_state:{}};\n if(message.type==='ui_event'&&active){const e=message.event;let id=null;if(e.type==='tap'&&e.id.startsWith('column_'))id=e.id;if(e.type==='drop'&&e.piece_id==='disc_'+s.turns&&e.id===e.piece_id)id=e.target_id;const option=legal.find(x=>'column_'+x.column===id);if(option){out.make_move={column:option.column};const reserve=pieces.find(x=>x.id==='disc_'+s.turns);if(reserve){reserve.board='main';reserve.position={x:25+50*option.column,y:6};}}}\n return out;\n}};\n\n// Append to Connect Four's native rack presentation. The last move is public\n// presentation data; old pinned rules retain equivalent provenance in disc_ids.\ngameUI.getLastMoveAnimations = function(view, scene) {\n  if (!Array.isArray(view.disc_ids)) return null;\n  if (view.last_move === null || view.turns === 0) return [];\n  const cell = view.last_move && Number.isInteger(view.last_move.cell)\n    ? view.last_move.cell\n    : Number.isInteger(view.turns) ? view.disc_ids.indexOf(view.turns - 1) : -1;\n  if (cell < 0 || cell >= 42 || !Number.isInteger(view.disc_ids[cell]) || view.disc_ids[cell] < 0) return null;\n  const piece = (scene.pieces || []).find(piece => piece.id === 'disc_' + view.disc_ids[cell]);\n  if (!piece || !Number.isFinite(piece.position.x) || !Number.isFinite(piece.position.y)) return null;\n  return [{piece_id:piece.id,duration_ms:600,path:[\n    {board:piece.board,position:{x:piece.position.x,y:-28}},\n    {board:piece.board,position:piece.position}\n  ]}];\n};\n",
  "version": 1,
