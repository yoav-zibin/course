{
  "name": "game-platform-ui-tests",
  "private": true,
  "scripts": {
    "lint:storage": "python3 scripts/check-device-storage.py",
    "build:portal": "node tools/build-portal.mjs",
    "test:portal": "npm --prefix frontends/portal test",
    "typecheck:portal": "npm --prefix frontends/portal run typecheck",
    "test:ui": "playwright test",
    "test:ui:headed": "playwright test --headed",
    "test:ui:ui": "playwright test --ui",
    "test:ui:report": "playwright show-report",
    "audit": "playwright test -c playwright.audit.config.ts"
  },
  "devDependencies": {
    "@playwright/test": "^1.49.0",
    "esbuild": "^0.28.2"
  }
}
